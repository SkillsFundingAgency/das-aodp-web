@using SFA.DAS.AODP.Web.Areas.Review.Controllers
@using SFA.DAS.AODP.Web.Factories
@using SFA.DAS.AODP.Web.Helpers
@using SFA.DAS.AODP.Web.Models.BulkActions
@using SFA.DAS.AODP.Web.Models.Qualifications
@model SFA.DAS.AODP.Web.Models.Qualifications.NewQualificationsViewModel
@{
    ViewData["Title"] = "New Qualifications";
    var backLinkModel = BackLinkModelFactory.Dashboard();
}
@await Html.PartialAsync("_BackLinkPartial", backLinkModel)
<partial name="~/Views/Shared/_NotificationPartial.cshtml" />
<partial name="_ValidationSummaryPartial" />


<div class="govuk-grid-row">
    <div class="govuk-grid-column-full" id="guide-contents">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h2 class="govuk-heading-l">New Qualifications</h2>
                <p class="govuk-body">Review and manage qualifications that have been newly regulated by Ofqual.</p>
                <p class="govuk-body">You can filter results to view only what you need, and comment and assign actions in bulk, or individually.</p>
            </div>
        </div>
        @if (Model.PaginationViewModel.CurrentPage > 0)
        {
            <div class="govuk-inset-text">Import for this cycle ran: @(Model.JobStatusViewModel.LastRunTime.HasValue? Model.JobStatusViewModel.LastRunTime.Value.ToString("G") : "Never")</div>
            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
        }

        <form asp-controller="New" asp-action="Search" asp-area="Review" method="post">
            <div class="govuk-grid-row" id="New_Qual_FilterSection">
                <div class="govuk-grid-column-full">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <h3 class="govuk-heading-m">Filters</h3>
                        </div>
                    </div>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <div class="govuk-form-group">
                                <govuk-input for="@Model.Filter.QualificationName" value="@Html.Encode(Model.Filter.QualificationName)" inputmode="text" spellcheck="false" autocomplete="off">
                                    <govuk-input-label is-page-heading="false" class="govuk-label--s">Qualification Title</govuk-input-label>
                                </govuk-input>
                            </div>
                            <div class="govuk-form-group">
                                <govuk-input for="@Model.Filter.QAN" value="@Html.Encode(Model.Filter.QAN)" inputmode="text" spellcheck="false" autocomplete="off">
                                    <govuk-input-label is-page-heading="false" class="govuk-label--s">QAN</govuk-input-label>
                                </govuk-input>
                            </div>
                            <div class="govuk-form-group">
                                <govuk-input for="@Model.Filter.Organisation" value="@Html.Encode(Model.Filter.Organisation)" inputmode="text" spellcheck="false" autocomplete="off">
                                    <govuk-input-label is-page-heading="false" class="govuk-label--s">Awarding Organisation</govuk-input-label>
                                </govuk-input>
                            </div>
                        </div>
                    </div>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-one-half">
                            <div class="govuk-form-group">
                                <fieldset class="govuk-fieldset govuk-!-static-padding-left-5">
                                    <govuk-checkboxes name="Filter[ProcessStatusIds]" for="@Model.Filter.ProcessStatusIds">

                                        <govuk-checkboxes-fieldset>

                                            <govuk-checkboxes-fieldset-legend is-page-heading="false" class="govuk-label--s">
                                                <div class="govuk-label govuk-label--s">Status</div>
                                            </govuk-checkboxes-fieldset-legend>

                                            @Html.RenderPartialAsync("Validation/_CheckboxValidationPartial", nameof(Model.Filter.ProcessStatusIds))

                                            @foreach (var status in Model.ProcessStatuses)
                                            {
                                                <govuk-checkboxes-item checked="@Model.Filter.ProcessStatusIds?.Contains(status.Id)" value="@status.Id">@status.Name</govuk-checkboxes-item>
                                            }

                                        </govuk-checkboxes-fieldset>

                                    </govuk-checkboxes>
                                </fieldset>
                            </div>
                        </div>
                        <div class="govuk-grid-column-one-half">
                            <div class="govuk-form-group">
                                <fieldset class="govuk-fieldset">

                                    <govuk-checkboxes name="Filter[AgeGroups]" for="@Model.Filter.AgeGroups">

                                        <govuk-checkboxes-fieldset>

                                            <govuk-checkboxes-fieldset-legend is-page-heading="false" class="govuk-label--s">
                                                <div class="govuk-label govuk-label--s">Age Groups</div>
                                            </govuk-checkboxes-fieldset-legend>

                                            @Html.RenderPartialAsync("Validation/_CheckboxValidationPartial", nameof(Model.Filter.AgeGroups))

                                            @foreach (var age in AgeGroupHelper.GetOptions())
                                            {
                                                <govuk-checkboxes-item value="@age.Value">
                                                    @age.Label
                                                </govuk-checkboxes-item>
                                            }

                                        </govuk-checkboxes-fieldset>

                                    </govuk-checkboxes>

                                </fieldset>
                            </div>
                        </div>
                    </div>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <govuk-select for="@Model.PaginationViewModel.RecordsPerPage">
                                <govuk-select-label>Qualifications Per Page</govuk-select-label>
                                <govuk-select-item value="10" selected="true">10</govuk-select-item>
                                <govuk-select-item value="20">20</govuk-select-item>
                                <govuk-select-item value="50">50</govuk-select-item>
                            </govuk-select>
                        </div>
                    </div>
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <div class="govuk-button-group">
                                <button type="submit"
                                        class="govuk-button govuk-button--secondary"
                                        data-module="govuk-button"
                                        data-prevent-double-click="true"
                                        value="true"
                                        name="Search">
                                    Search
                                </button>
                                <a class="govuk-button govuk-button--secondary" asp-action="Clear" asp-controller="New" asp-area="Review" asp-route-recordsPerPAge="@Model.PaginationViewModel.RecordsPerPage">
                                    Clear
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        @if (Model.PaginationViewModel.CurrentPage > 0)
        {
            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
            @if (Model.NewQualifications.Any())
            {
                <form asp-controller="New" asp-action="ApplyBulkAction" asp-area="Review" method="post">
                    @{
                        var selectionHasError =
                        ViewData.ModelState.TryGetValue(nameof(NewQualificationsViewModel.SelectedQualificationIds), out var selState) &&
                        selState.Errors.Count > 0;

                    }

                    <div id="SelectedQualificationIds" class="govuk-form-group @(selectionHasError ? "govuk-form-group--error" : "")">
                        <h3 class="govuk-heading-m">Qualifications</h3>
                        <span asp-validation-for="SelectedQualificationIds" class="govuk-error-message"></span>

                        <div class="govuk-grid-row" id="New_Qual_Pagination_Header_Section">
                            <div class="govuk-grid-column-full">
                                <p>Viewing @(Model.PaginationViewModel.StartRecord) - @(Model.PaginationViewModel.EndRecord) of @(Model.PaginationViewModel.TotalRecords) Qualifications</p>
                            </div>
                        </div>

                        @{
                            var selectAllCheckboxesViewModel = SelectAllViewModelFactory.ForQualifications
                            (
                                nameof(NewController).Replace("Controller", "")
                            );
                        }

                        <partial name="~/Views/Shared/_SelectAllOnPage.cshtml" model="selectAllCheckboxesViewModel" />

                        <div class="govuk-grid-row" id="New_Qual_Data_Section">
                            <div class="govuk-grid-column-full">
                                <table class="govuk-table">
                                    <thead class="govuk-table__head">
                                        <tr class="govuk-table__row">
                                            <partial name="~/Views/Shared/_SelectColumnHeader.cshtml" />
                                            <th class="govuk-table__header">QAN</th>
                                            <th class="govuk-table__header">Qualification Title</th>
                                            <th class="govuk-table__header">Age Group(s)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="govuk-table__body">
                                        @foreach (var qualification in Model.NewQualifications)
                                        {
                                            var isChecked = Model.SelectedQualificationIds?.Contains(qualification.QualificationId) ?? false;
                                            var checkboxModel = new MultiSelectCheckboxCellViewModel
                                            (
                                                qualification.QualificationId,
                                                qualification.Title ?? string.Empty,
                                                isChecked,
                                                nameof(Model.SelectedQualificationIds),
                                                "qual"
                                            );
                                            <tr class="govuk-table__row">
                                                <partial name="~/Views/Shared/_SelectCheckboxCell.cshtml"
                                                            model="checkboxModel" />

                                                <td class="govuk-table__cell">
                                                    @if (!string.IsNullOrWhiteSpace(qualification.Reference))
                                                    {
                                                        <ofqual-register qualification-reference="@qualification.Reference" />
                                                    }
                                                </td>
                                                <td class="govuk-table__cell">
                                                    <a class="govuk-link" href="@Url.Action("QualificationDetails", "New", new { area = "Review", qualificationReference = qualification.Reference })">
                                                        @qualification.Title
                                                    </a>
                                                </td>
                                                <td class="govuk-table__cell">@qualification.AgeGroup</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @if (Model.PaginationViewModel.TotalPages > 0)
                    {
                        <p class="govuk-body">Navigating to another page clears this selection. If you want to comment or assign actions to results on this page, do so before clicking on another page.</p>

                        <div class="govuk-grid-row" id="New_Qual_Pagination_Footer_Section">
                            <div class="govuk-grid-column-three-quarters">
                                <partial name="~/Views/Shared/GdsComponents/_GdsSessionPagination.cshtml" model="Model.GdsPagination" />
                            </div>
                        </div>

                        <div class="govuk-grid-row">
                            <div class="govuk-button-group">
                                <a class="govuk-button govuk-button--secondary" asp-controller="New" asp-action="ExportData" asp-route-area="Review" asp-route-status="New">
                                    Download
                                </a>
                            </div>
                        </div>

                    }
                    <partial name="~/Views/Shared/Qualifications/_QualificationsBulkActionPanel.cshtml" model="Model" />

                </form>
            }
            else
            {
                <div class="govuk-grid-row" id="Empty_Data_Section">
                    <div class="govuk-grid-column-full">
                        <table class="govuk-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th class="govuk-table__header">QAN</th>
                                    <th class="govuk-table__header">Qualification Title</th>
                                    <th class="govuk-table__header">Age Group</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">No qualifications match your search criteria</td>
                                    <td class="govuk-table__cell"></td>
                                    <td class="govuk-table__cell"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>
