@using SFA.DAS.AODP.Web.Areas.Review.Controllers
@using SFA.DAS.AODP.Web.Factories
@using SFA.DAS.AODP.Web.Models.BulkActions
@using SFA.DAS.AODP.Web.Models.Qualifications
@model SFA.DAS.AODP.Web.Models.Qualifications.ChangedQualificationsViewModel
@{
    ViewData["Title"] = "Changed Qualifications";
    var backLinkModel = BackLinkModelFactory.Dashboard();
}
@await Html.PartialAsync("_BackLinkPartial", backLinkModel)
<partial name="~/Views/Shared/_NotificationPartial.cshtml" />
<partial name="_ValidationSummaryPartial" />


<div class="govuk-tabs">
    <h2 class="govuk-tabs__title">
        Contents
    </h2>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full" id="guide-contents">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <h2 class="govuk-heading-l">Qualifications with changes</h2>
                    <p class="govuk-body">Review qualifications that have had changes made to them.</p>
                    <p class="govuk-body">You can filter results to view only what you need, and comment and assign actions in bulk, or individually.</p>
                </div>
            </div>

            @if (Model.PaginationViewModel.CurrentPage > 0)
            {
                <div class="govuk-inset-text">
                    Import for this cycle ran: @(Model.JobStatusViewModel.LastRunTime.HasValue? Model.JobStatusViewModel.LastRunTime.Value.ToString("G") : "Never")
                </div>
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
            }

            <form asp-controller="Changed" asp-action="Search" asp-area="Review" method="post">
                <div class="govuk-grid-row" id="New_Qual_FilterSection">
                    <div class="govuk-grid-column-full">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <h3 class="govuk-heading-m">Filters</h3>
                            </div>
                        </div>
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-one-half">
                                <div class="govuk-form-group">
                                    <govuk-input asp-for="@Model.Filter.QualificationName" inputmode="text" spellcheck="false" autocomplete="off">
                                        <govuk-input-label is-page-heading="false" class="govuk-label--s">Qualification Title</govuk-input-label>
                                    </govuk-input>
                                </div>
                                <div class="govuk-form-group">
                                    <govuk-input asp-for="@Model.Filter.QAN" inputmode="text" spellcheck="false" autocomplete="off">
                                        <govuk-input-label is-page-heading="false" class="govuk-label--s">QAN</govuk-input-label>
                                    </govuk-input>
                                </div>
                                <div class="govuk-form-group">
                                    <govuk-input asp-for="@Model.Filter.Organisation" inputmode="text" spellcheck="false" autocomplete="off">
                                        <govuk-input-label is-page-heading="false" class="govuk-label--s">Awarding Organisation</govuk-input-label>
                                    </govuk-input>
                                </div>
                            </div>
                            <div class="govuk-grid-column-one-half">
                                <div class="govuk-form-group">
                                    <fieldset class="govuk-fieldset govuk-!-static-padding-left-5">
                                        <govuk-checkboxes name="Filter[ProcessStatusIds]" for="@Model.Filter.ProcessStatusIds">
                                            <govuk-checkboxes-fieldset>
                                                <govuk-checkboxes-fieldset-legend is-page-heading="false" class="govuk-label--s">
                                                    <div class="govuk-label govuk-label--s">Status</div>
                                                </govuk-checkboxes-fieldset-legend>

                                                @Html.RenderPartialAsync("Validation/_CheckboxValidationPartial", nameof(Model.Filter.ProcessStatusIds))

                                                @foreach (var status in Model.ProcessStatuses)
                                                {
                                                    <govuk-checkboxes-item checked="@Model.Filter.ProcessStatusIds?.Contains(status.Id)" value="@status.Id">@status.Name</govuk-checkboxes-item>
                                                }
                                            </govuk-checkboxes-fieldset>
                                        </govuk-checkboxes>
                                    </fieldset>
                                </div>
                            </div>
                        </div>

                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <govuk-select asp-for="@Model.PaginationViewModel.RecordsPerPage">
                                    <govuk-select-label>Qualifications Per Page</govuk-select-label>
                                    <govuk-select-item value="10" selected="true">10</govuk-select-item>
                                    <govuk-select-item value="20">20</govuk-select-item>
                                    <govuk-select-item value="50">50</govuk-select-item>
                                </govuk-select>
                            </div>
                        </div>

                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div class="govuk-button-group">
                                    <button type="submit"
                                            class="govuk-button govuk-button--secondary"
                                            data-module="govuk-button"
                                            data-prevent-double-click="true"
                                            value="true"
                                            name="Search">
                                        Search
                                    </button>
                                    <a class="govuk-button govuk-button--secondary"
                                        asp-action="Clear"
                                        asp-controller="Changed"
                                        asp-area="Review"
                                        asp-route-recordsPerPAge="@Model.PaginationViewModel.RecordsPerPage">
                                        Clear
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </form>

            @if (Model.PaginationViewModel.CurrentPage > 0)
            {
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

                @if (Model.ChangedQualifications.Any())
                {
                    <form asp-controller="Changed" asp-action="ApplyBulkAction" asp-area="Review" method="post">
                        @{
                            var selectionHasError =
                                ViewData.ModelState.TryGetValue("SelectedQualificationIds", out var selState) &&
                                selState.Errors.Count > 0;
                        }

                        <div class="govuk-grid-row" id="New_Qual_Pagination_Header_Section">
                            <div class="govuk-grid-column-full">
                                <h3 class="govuk-heading-m">Qualifications</h3>
                                <p>Viewing @(Model.PaginationViewModel.StartRecord) - @(Model.PaginationViewModel.EndRecord) of @(Model.PaginationViewModel.TotalRecords) Qualifications</p>
                            </div>
                        </div>

                        <div id="SelectedQualificationIds" class="govuk-form-group @(selectionHasError ? "govuk-form-group--error" : "")">
                            <span asp-validation-for="SelectedQualificationIds" class="govuk-error-message"></span>

                            @{
                                var selectAllViewModel = SelectAllViewModelFactory.ForQualifications(
                                    nameof(ChangedController).Replace("Controller", "")
                                );
                            }

                            <partial name="~/Views/Shared/_SelectAllOnPage.cshtml"
                                        model="selectAllViewModel" />

                            <div class="govuk-grid-row" id="New_Qual_Data_Section">
                                <div class="govuk-grid-column-full">
                                    <table class="govuk-table">
                                        <thead class="govuk-table__head">
                                            <tr class="govuk-table__row">
                                                <partial name="~/Views/Shared/_SelectColumnHeader.cshtml" />
                                                <th class="govuk-table__header">QAN</th>
                                                <th class="govuk-table__header">Qualification Title</th>
                                                <th class="govuk-table__header">Changes</th>
                                                <th class="govuk-table__header">Eligibility status</th>
                                                <th class="govuk-table__header">Priority / Status</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body">
                                            @foreach (var qualification in Model.ChangedQualifications)
                                            {
                                                var isChecked = Model.SelectedQualificationIds.Contains(qualification.QualificationId);
                                                var theModel = new MultiSelectCheckboxCellViewModel
                                                (
                                                    qualification.QualificationId,
                                                    qualification.QualificationTitle ?? string.Empty,
                                                    isChecked,
                                                    nameof(Model.SelectedQualificationIds),
                                                    "qual"
                                                );

                                                <tr class="govuk-table__row">
                                                    <partial name="~/Views/Shared/_SelectCheckboxCell.cshtml" model="@theModel" />

                                                    <td class="govuk-table__cell">
                                                        @if (!string.IsNullOrWhiteSpace(qualification.QualificationReference))
                                                        {
                                                            <ofqual-register qualification-reference="@qualification.QualificationReference" />
                                                        }
                                                    </td>
                                                    <td class="govuk-table__cell">
                                                        <a class="govuk-link"
                                                            asp-action="QualificationDetails"
                                                            asp-controller="Changed"
                                                            asp-route-qualificationReference="@qualification.QualificationReference"
                                                            asp-route-status="changed">
                                                            @qualification.QualificationTitle
                                                        </a>
                                                    </td>
                                                    <td class="govuk-table__cell">@qualification.KeyFieldsForDisplay</td>
                                                    <td class="govuk-table__cell">@qualification.EligibilityStatus</td>
                                                    <td class="govuk-table__cell">@qualification.Priority/@qualification.CurrentProcessStatus.Name</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        @if (Model.PaginationViewModel.TotalPages > 0)
                        {
                            <p class="govuk-body">Navigating to another page clears this selection. If you want to comment or assign actions to results on this page, do so before clicking on another page.</p>

                            <div class="govuk-grid-row" id="New_Qual_Pagination_Footer_Section">
                                <div class="govuk-grid-column-three-quarters">
                                    <partial name="~/Views/Shared/GdsComponents/_GdsSessionPagination.cshtml"
                                             model="Model.GdsPagination" />

                                </div>
                            </div>

                            <div class="govuk-grid-row">
                                <div class="govuk-button-group">
                                    <a class="govuk-button govuk-button--secondary"
                                        asp-controller="Changed"
                                        asp-action="ExportData"
                                        asp-route-area="Review"
                                        asp-route-status="Changed">
                                        Download
                                    </a>
                                </div>
                            </div>
                        }

                        <partial name="~/Views/Shared/Qualifications/_QualificationsBulkActionPanel.cshtml" model="Model" />
                    </form>
                }
                else
                {
                    <div class="govuk-grid-row" id="Empty_Data_Section">
                        <div class="govuk-grid-column-full">
                            <table class="govuk-table">
                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th class="govuk-table__header">QAN</th>
                                        <th class="govuk-table__header">Qualification Title</th>
                                        <th class="govuk-table__header">Age Group(s)</th>
                                    </tr>
                                </thead>
                                <tbody class="govuk-table__body">
                                    <tr class="govuk-table__row">
                                        <td class="govuk-table__cell">No Results</td>
                                        <td class="govuk-table__cell"></td>
                                        <td class="govuk-table__cell"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div>
