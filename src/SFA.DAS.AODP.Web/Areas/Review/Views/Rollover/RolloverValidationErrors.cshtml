@using SFA.DAS.AODP.Web.Areas.Review.Controllers
@using SFA.DAS.AODP.Web.Areas.Review.Models.Rollover
@using SFA.DAS.AODP.Web.Views.Shared
@model RolloverUploadQualificationsViewModel
@{
    ViewData["Title"] = "There are validation errors in the file you imported"; var backLinkModel = new BackLinkModel
    {
        Action = nameof(RolloverController.UploadQualificationsToRollover),
        Controller = "Rollover",
        Area = "Review"
    };
}

@await Html.PartialAsync("_BackLinkPartial", backLinkModel)
<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds" id="guide-contents">
                <partial name="_FileUploadErrors" model="Model" />

                <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

                <partial name="_RolloverCandidatesValidationErrors" model="Model" />

                <partial name="_ValidateCandidatesFileUpload" model="Model" />
            </<div>
        </div>
    </main>
</div>