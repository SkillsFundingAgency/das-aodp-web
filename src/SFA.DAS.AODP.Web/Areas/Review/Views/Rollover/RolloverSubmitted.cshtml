@{
    ViewData["Title"] = "Rollover submitted";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-grid-row">
            <div class="govuk-panel--confirmation govuk-panel">
                <h1 class="govuk-panel__title">@ViewData["Title"]</h1>
            </div>

            <h2 class="govuk-heading-m">
                What you can do next
            </h2>

            <p class="govuk-body">
                <a class="govuk-link"
                   asp-action="Index"
                   asp-controller="Home">
                    Go to the QFAST homepage
                </a>
            </p>
        </div>
    </div>
</div>