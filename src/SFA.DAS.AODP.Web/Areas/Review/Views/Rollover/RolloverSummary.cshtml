@using SFA.DAS.AODP.Web.Areas.Review.Controllers
@using SFA.DAS.AODP.Web.Views.Shared
@model SFA.DAS.AODP.Web.Areas.Review.Models.Rollover.RolloverSummaryViewModel;
@{
    ViewData["Title"] = "Rollover summary";

    var backLinkModel = new BackLinkModel
    {
        Action = nameof(RolloverController.UploadQualificationsToRollover),
        Controller = "Rollover",
        Area = "Review"
    };
}

@await Html.PartialAsync("_BackLinkPartial", backLinkModel)

<div class="govuk-width-container">
    <main class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds" id="guide-contents">

                <h1 class="govuk-heading-l">@ViewData["Title"]</h1>

                <p class="govuk-body">
                    <strong>This will rollover @Model.CandidatesExtendedInUploadCount candidates.</strong>
                </p>

                <p class="govuk-body">
                    There are currently @Model.TotalCandidatesCount candidates for rollover.
                </p>

                <p class="govuk-body">If you submit these candidates, then in the current academic year you will have:</p>

                <ul class="govuk-list govuk-list--bullet">
                    <li>reviewed these @Model.TotalCandidatesToBeExtendedCount candidates for rollover and extended their funding</li>
                    <li>reviewed @Model.TotalCandidatesToBeExcludedCount candidates and did not approve them for continued funding</li>
                </ul>

                <p class="govuk-body">
                    There will be @Model.TotalCandidatesToBeReviewedCount candidates for rollover left to review after submitting these.
                </p>

                <form method="post">
                    <button class="govuk-button govuk-button--primary" data-module="govuk-button">
                        Submit rollover
                    </button>
                </form>
            </<div>
        </div>
    </main>
</div>

