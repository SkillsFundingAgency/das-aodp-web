@using SFA.DAS.AODP.Models.Application
@using SFA.DAS.AODP.Models.Users
@using SFA.DAS.AODP.Web.Areas.Review.Models.ApplicationsReview
@model ApplicationReviewViewModel

@{
    ViewData["Title"] = Model.Name;

    var currentUserReview = Model.Feedbacks.Where(f => f.UserType == Model.UserType.ToString()).First();

    var IsReadOnly = Model.ApplicationStatus is ApplicationStatus.Withdrawn || Model.IsApplicationCompleted;
    var canEditApplicationDetails = !IsReadOnly && Model.UserType == UserType.Qfau;
    var backHref = Model.BackUrl ?? Url.Action("Index", "ApplicationsReview", new { area = "Review" });
}

<a class="govuk-back-link govuk-link govuk-task-list__link" href="@backHref">Back</a>

@if (Model.ApplicationStatus == ApplicationStatus.Withdrawn)
{
    <div class="govuk-notification-banner" role="banner" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                Important
            </h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
                This application has been withdrawn. It can only be used for reference purposes.
            </p>
        </div>
    </div>
}

<partial name="~/Views/Shared/_NotificationPartial.cshtml" />
<partial name="~/Views/Shared/_ValidationSummaryPartial.cshtml" />

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="govuk-grid-row">
            <span class="govuk-caption-xl">
                @(Model.IsApplicationCompleted ? "Completed application" : "Request for funding")
            </span>
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
                Application details
            </h1>
            <p class="govuk-!-margin-bottom-6">
                <a class="govuk-link"
                   asp-route="Review_ApplicationMessages"
                   asp-route-applicationReviewId="@Model.ApplicationReviewId">
                    View messages
                </a>
            </p>
        </div>

        <div class="govuk-grid-row">
            @if (canEditApplicationDetails)
            {
                <form id="application-details-form"
                      asp-route-applicationReviewId="@Model.ApplicationReviewId"
                      asp-action="SaveApplicationDetails"
                      asp-controller="ApplicationsReview"
                      method="post"
                      gfa-prepend-error-summary="false">
                    <input type="hidden" name="ApplicationReviewId" value="@Model.ApplicationReviewId" />
                    <input type="hidden" name="ApplicationId" value="@Model.Id" />
                </form>
            }

            <govuk-summary-list>
                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Form title
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.FormTitle
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Status
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @{
                            if (Enum.TryParse<ApplicationStatus>(currentUserReview.Status, out var status))
                            {
                                if (currentUserReview.Status == ApplicationStatus.Approved.ToString() && Model.UserType == UserType.Qfau)
                                {
                                    <span>Approved - for one or more offers</span>
                                }
                                else
                                {
                                    @ApplicationStatusDisplay.Dictionary[status]
                                }
                            }
                            else
                            {
                                <span>In review</span>
                            }
                        }
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Awarding organisation
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.AwardingOrganisation
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Qualification title
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @Model.Name
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>



                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        QAN
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @if (canEditApplicationDetails)
                        {
                            <span asp-validation-for="Qan" class="govuk-error-message"></span>
                            <div class="govuk-form-group govuk-!-margin-bottom-0">
                                <div class="select-picker qan-input">
                                    <label class="govuk-label govuk-visually-hidden" for="Qan">Update QAN</label>
                                    <input class="govuk-input"
                                           id="Qan"
                                           name="Qan"
                                           type="text"
                                           value="@Model.Qan"
                                           autocomplete="off"
                                           form="application-details-form" />
                                </div>
                            </div>
                        }
                        else
                        {
                            @Model.Qan
                        }
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>

                @if (Model.UserType == UserType.Ofqual || Model.UserType == UserType.SkillsEngland)
                {
                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Assigned to
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @if (!IsReadOnly)
                            {
                                <form asp-route-applicationReviewId="@Model.ApplicationReviewId"
                                      asp-action="UpdateOwner"
                                      asp-Controller="ApplicationsReview"
                                      method="post"
                                      gfa-prepend-error-summary="false">

                                    <div class="govuk-form-group govuk-!-margin-bottom-0">
                                        <div class="select-picker">
                                            <govuk-input for="@currentUserReview.Owner" value="@Html.Encode(currentUserReview.Owner)" name="Owner" autocomplete="off">
                                                <govuk-input-label class="govuk-visually-hidden">Update owner</govuk-input-label>
                                            </govuk-input>
                                            <govuk-button class="govuk-button  govuk-button--secondary" type="submit">Update</govuk-button>
                                        </div>
                                    </div>
                                </form>
                            }
                            else
                            {
                                @currentUserReview.Owner
                            }
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>
                }

                @if (Model.UserType == SFA.DAS.AODP.Models.Users.UserType.Qfau)
                {
                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Reviewer 1
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @if (canEditApplicationDetails)
                            {
                                <span asp-validation-for="Reviewer1" class="govuk-error-message"></span>
                                <div class="govuk-form-group govuk-!-margin-bottom-0">
                                    <div class="select-picker">
                                        <label class="govuk-label govuk-visually-hidden" asp-for="Reviewer1">Reviewer 1</label>
                                        <select asp-for="Reviewer1"
                                                class="govuk-select"
                                                asp-items="Model.ReviewerOptions"
                                                form="application-details-form">
                                        </select>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @Model.Reviewer1
                            }
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>

                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Reviewer 2
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @if (canEditApplicationDetails)
                            {
                                <span asp-validation-for="Reviewer2" class="govuk-error-message"></span>
                                <div class="govuk-form-group govuk-!-margin-bottom-0">
                                    <div class="select-picker">
                                        <label class="govuk-label govuk-visually-hidden" asp-for="Reviewer2">Reviewer 2</label>
                                        <select asp-for="Reviewer2"
                                                class="govuk-select"
                                                asp-items="Model.ReviewerOptions"
                                                form="application-details-form">
                                        </select>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @Model.Reviewer2
                            }
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>

                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Shared with Skills England
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @(Model.SharedWithSkillsEngland ? "Yes" : "No")
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>

                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Shared with Ofqual
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @(Model.SharedWithOfqual ? "Yes" : "No")
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>

                    <govuk-summary-list-row>
                        <govuk-summary-list-row-key>
                            Latest decision communicated to AO
                        </govuk-summary-list-row-key>
                        <govuk-summary-list-row-value>
                            @(currentUserReview.LatestCommunicatedToAwardingOrganisation ? "Yes" : "No")
                        </govuk-summary-list-row-value>
                    </govuk-summary-list-row>
                }
            </govuk-summary-list>

            @if (canEditApplicationDetails)
            {
                <button class="govuk-button govuk-button--secondary" data-module="govuk-button" type="submit" form="application-details-form">Save</button>
            }

            @if (Model.UserType == SFA.DAS.AODP.Models.Users.UserType.Qfau)
            {
                <div class="govuk-grid-row">
                    <h2 class="govuk-heading-m">Download application</h2>
                    <p class="govuk-body">This will download a ZIP file containing a summary file and any attachments associated with the application to your device.</p>


                    <a class="govuk-button govuk-button--secondary" asp-action="DownloadApplicationFormAndFiles" asp-controller="ApplicationsReview" asp-route-applicationReviewId="@Model.ApplicationReviewId">
                        Download application
                    </a>
                </div>
            }

            @if (!IsReadOnly)
            {
                @if (Model.UserType == SFA.DAS.AODP.Models.Users.UserType.Qfau)
                {
                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">DfE funding review</h2>
                        <p class="govuk-body">Review application, make decision on approval and funding options.</p>

                        @if (currentUserReview.Status == ApplicationStatus.Approved.ToString() || currentUserReview.Status == ApplicationStatus.NotApproved.ToString())
                        {
                            <a class="govuk-button govuk-button--secondary" asp-action="QfauFundingReviewSummary" asp-controller="ApplicationsReview" asp-route-applicationReviewId="@Model.ApplicationReviewId">
                                DfE funding review
                            </a>
                        }
                        else
                        {
                            <a class="govuk-button govuk-button--secondary" asp-action="QfauFundingReviewOutcome" asp-controller="ApplicationsReview" asp-route-applicationReviewId="@Model.ApplicationReviewId">
                                DfE funding review
                            </a>
                        }
                    </div>

                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">Skills England review</h2>

                        @{
                            var seMessage = $"{(!Model.SharedWithSkillsEngland ? "Share with Skills England" : "Unshare with Skills England")}";
                        }
                        @{
                            await RenderSkillsEnglandReview();
                        }

                        <a class="govuk-button govuk-button--secondary"
                           asp-action="ShareApplicationConfirmation"
                           asp-controller="ApplicationsReview"
                           asp-route-applicationReviewId="@Model.ApplicationReviewId"
                           asp-route-share="@(!Model.SharedWithSkillsEngland)"
                           asp-route-userType="@UserType.SkillsEngland">
                            @seMessage
                        </a>
                    </div>

                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">Ofqual review</h2>

                        @{
                            var ofqualMessage = $"{(!Model.SharedWithOfqual ? "Share with Ofqual" : "Unshare with Ofqual")}";
                        }
                        @{
                            await RenderOfqualReview();
                        }

                        <a class="govuk-button govuk-button--secondary"
                           asp-action="ShareApplicationConfirmation"
                           asp-controller="ApplicationsReview"
                           asp-route-applicationReviewId="@Model.ApplicationReviewId"
                           asp-route-share="@(!Model.SharedWithOfqual)"
                           asp-route-userType="@UserType.Ofqual">
                            @ofqualMessage
                        </a>
                    </div>

                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">Application funding decision</h2>
                        <p class="govuk-body">Inform the AO of the decision regarding approval and funding options.</p>

                        <a class="govuk-button" asp-action="QfauFundingReviewDecision" asp-controller="ApplicationsReview" asp-route-applicationReviewId="@Model.ApplicationReviewId">
                            Application funding decision
                        </a>
                    </div>
                }

                @if (Model.UserType == SFA.DAS.AODP.Models.Users.UserType.Ofqual)
                {
                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">Ofqual review</h2>
                        @{
                            await RenderOfqualReview();
                        }

                        <a class="govuk-button"
                           asp-action="OfqualReview"
                           asp-controller="ApplicationsReview"
                           asp-route-applicationReviewId="@Model.ApplicationReviewId">
                            Review
                        </a>
                    </div>
                }

                @if (Model.UserType == SFA.DAS.AODP.Models.Users.UserType.SkillsEngland)
                {
                    <div class="govuk-grid-row">
                        <h2 class="govuk-heading-m">Skills England review</h2>

                        @{
                            await RenderSkillsEnglandReview();
                        }

                        <a class="govuk-button"
                           asp-action="SkillsEnglandReview"
                           asp-controller="ApplicationsReview"
                           asp-route-applicationReviewId="@Model.ApplicationReviewId">
                            Review
                        </a>
                    </div>
                }
            }
        </div>

    </div>

    <div class="govuk-grid-column-one-third"> 
        @await Html.PartialAsync("_RelatedLinks", Model.RelatedLinks)
    </div>

</div>

@{
    async Task RenderOfqualReview()
    {
        var review = Model.Feedbacks.FirstOrDefault(f => f.UserType == UserType.Ofqual.ToString());

        if (review != null && review.Status != ApplicationStatus.InReview.ToString())
        {
            <govuk-summary-list>
                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Comments
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        <p style="white-space: pre-line">@review.Comments</p>
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>
            </govuk-summary-list>
        }
    }

    async Task RenderSkillsEnglandReview()
    {
        var review = Model.Feedbacks.FirstOrDefault(f => f.UserType == UserType.SkillsEngland.ToString());

        if (review != null && review.Status != ApplicationStatus.InReview.ToString())
        {
            <govuk-summary-list>
                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Status
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        @if (review.Status == ApplicationStatus.Approved.ToString())
                        {
                            <p class="govuk-body">Approved</p>
                        }
                        else
                        {
                            <p class="govuk-body">Not approved</p>
                        }
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>
                <govuk-summary-list-row>
                    <govuk-summary-list-row-key>
                        Comments
                    </govuk-summary-list-row-key>
                    <govuk-summary-list-row-value>
                        <p style="white-space: pre-line">@review.Comments</p> bvj 
                    </govuk-summary-list-row-value>
                </govuk-summary-list-row>
            </govuk-summary-list>
        }
    }
}
