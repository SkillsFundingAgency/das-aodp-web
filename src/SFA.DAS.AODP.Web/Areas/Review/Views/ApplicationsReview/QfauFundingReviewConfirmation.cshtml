@using SFA.DAS.AODP.Web.Areas.Review.Models.ApplicationsReview
@model ReviewConfirmationViewModel;

@{
    ViewData["Title"] = "Funding review confirmation";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-grid-row">
            <div class="govuk-panel--confirmation govuk-panel">
                <h1 class="govuk-panel__title">Decision saved</h1>
            </div>

            <p class="govuk-body">
                You have made a decision on funding options for this qualification. You can still make amends before you inform the AO. 
            </p>

            <h2 class="govuk-heading-m">
                What you can do next
            </h2>

            <p class="govuk-body">
                To view application details, make a change to the decision or confirm it and inform the AO, go to
                <a class="govuk-link"
                   asp-area="Review"
                   asp-action="ViewApplication"
                   asp-route-applicationReviewId="@Model.ApplicationReviewId"
                   asp-controller="ApplicationsReview">
                    Application details
                </a>.
            </p>

            <p class="govuk-body">
                To view a different application, go to the
                <a class="govuk-link"
                   asp-area="Review"
                   asp-action="Index"
                   asp-controller="Home">
                    QFAST homepage
                </a>.
            </p>
        </div>
    </div>
</div>